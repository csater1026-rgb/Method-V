# Copy to mobile/.env. Leave the Supabase values empty to run in demo mode.
# EXPO_PUBLIC_ values are built into the app, so only put public keys here
# (never the Supabase secret key or Stripe keys).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The website, e.g. https://methodv.app. Posting goes through it (it runs the
# link check), and the Me tab opens Stats, Earn and Credits there.
EXPO_PUBLIC_SITE_URL=

# Optional one-tap sign-in: google, apple, or both (see README).
EXPO_PUBLIC_AUTH_PROVIDERS=
