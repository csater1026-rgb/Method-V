# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Leave these empty to run in demo mode.

NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). An older anon key also works
# under NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, never exposed to the browser. Used to mark an app's link as
# checked after the server verifies it loads. The secret key (sb_secret_...)
# or the older service_role key under SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Optional. Your public site address, used in sign-in emails. Defaults to the
# address the request came in on.
NEXT_PUBLIC_SITE_URL=

# Optional. One-tap sign-in buttons. Turn the providers on in Supabase first
# (Authentication → Providers), then list them here: google, apple, github
# (any of them, comma separated).
NEXT_PUBLIC_AUTH_PROVIDERS=

# Optional. Payments (tips, Boost Exchange sponsorships, Pro, payouts) through
# Stripe and Stripe Connect. Payments stay off unless both of these and
# SUPABASE_SECRET_KEY are set. See README step 6.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Push notifications (README step 7). Make all three at
# /setup/push-keys. Sending is off until PUSH_WEBHOOK_SECRET is set; browsers
# also need the two VAPID keys. EXPO_ACCESS_TOKEN only if you turned on
# Expo's enhanced push security.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=
EXPO_ACCESS_TOKEN=
